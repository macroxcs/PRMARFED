# ============================================================
# STANDARDIZED IRFs
# ============================================================
horizon = 20
h = np.arange(horizon)
shock_names = ['Technology', 'US Inflation', 'Oil Price', 'Fed Funds', 'Transfers', 'Shipping']

def irf(C, j):
    return C[j] * (rho[j] ** h)

# --- Output ---
fig, axes = plt.subplots(2, 3, figsize=(14, 8), sharex=True)
axes = axes.flatten()
for j in range(6):
    ax = axes[j]
    ax.plot(h, irf(C_y_b, j), 'b-',  lw=2, label='Baseline')
    ax.plot(h, irf(C_y_r, j), 'r--', lw=2, label='Repeal')
    ax.axhline(0, color='k', lw=0.7, alpha=0.5)
    ax.set_title(shock_names[j])
    ax.grid(True, alpha=0.3)
    if j == 0: ax.legend(fontsize=9)
    if j >= 3: ax.set_xlabel('Quarters')
    ax.set_ylabel('Output Gap')
fig.suptitle('Standardized IRFs – Output Gap (Baseline vs Repeal)', fontsize=14)
plt.tight_layout()
plt.savefig('IRF_Output_Final.png', dpi=300, bbox_inches='tight')
plt.show()

