        'alpha': 0.33,
        'xi': 0.75,
        'rho_a': 0.850,
        'rho_pi': 0.767,
        'rho_o': 0.918,
        'rho_i': 0.900,
        'rho_tr': 0.986,
        'rho_ship': 0.947,
        'sigma_a': 0.007,
        'sigma_pi': 0.0056,
        'sigma_o': 0.145,
        'sigma_i': 0.002,
        'sigma_tr': 0.0277,
        'sigma_ship': 0.0386,
        'gamma_direct': 0.142,
