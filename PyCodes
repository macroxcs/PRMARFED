# 4. STATISTICAL EVALUATORS (MOMENTS & FEVD)
# ==============================================================================
def compute_table3_moments():
    N = np.diag(rhos)
    Sigma_x = np.diag((sigmas**2) / (1.0 - (rhos**2)))
    
    var_y = Cy_base @ Sigma_x @ Cy_base
    sd_y_model = np.sqrt(var_y)
    
    var_pi = Cpi_base @ Sigma_x @ Cpi_base
    sd_pi_model = np.sqrt(var_pi)
    
    cov_y_lag = Cy_base @ N @ Sigma_x @ Cy_base
    rho_y_model = cov_y_lag / var_y
    
    cov_pi_lag = Cpi_base @ N @ Sigma_x @ Cpi_base
    rho_pi_model = cov_pi_lag / var_pi
    
    cov_y_pi = Cy_base @ Sigma_x @ Cpi_base
    corr_y_pi_model = cov_y_pi / (sd_y_model * sd_pi_model)
    
    return pd.DataFrame({
        "Structural Second Moment": [
            "Standard Deviation sd(y_hat) (Output Gap)",
            "Standard Deviation sd(pi_hat) (CPI Inflation)",
            "First-Order Autocorrelation rho(y_t, y_{t-1})",
            "First-Order Autocorrelation rho(pi_t, pi_{t-1})",
            "Cross-Correlation corr(y_t, pi_t)"
        ],
        "Historical Data (Chow-Lin)": [0.0245, 0.0189, 0.8120, 0.6430, 0.3840],
        "Model Asymptotic": [
            np.round(sd_y_model, 4),
            np.round(sd_pi_model, 4),
            np.round(rho_y_model, 4),
            np.round(rho_pi_model, 4),
            np.round(corr_y_pi_model, 4)
        ]
    })

def compute_finite_fevd_corrected(C_vec, rhos, sigmas, horizon):
    n_shocks = len(rhos)
    mse_contrib = np.zeros(n_shocks)
    for i in range(n_shocks):
        h_steps = np.arange(horizon)
        irf_path = C_vec[i] * (rhos[i] ** h_steps) * sigmas[i]
        mse_contrib[i] = np.sum(irf_path ** 2)
    return 100.0 * mse_contrib / np.sum(mse_contrib)

def compute_asymptotic_fevd_corrected(C_vec, rhos, sigmas):
    var_contrib = (C_vec ** 2) * (sigmas ** 2) / (1.0 - rhos ** 2)
    return 100.0 * var_contrib / np.sum(var_contrib)

def generate_irf(C_vec_i, rho_i, horizon=11):
    return C_vec_i * (rho_i ** np.arange(horizon))


