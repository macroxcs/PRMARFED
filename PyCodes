import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

# ============================================================
# Final policy vectors (ψ_y = 0.08)
# ============================================================
# Baseline
C_pi_b = np.array([-0.1758,  0.0794,  0.0107, -0.0910,  0.0514,  0.0175])
C_y_b  = np.array([ 0.1103, -1.4121, -0.3148, -1.4445,  1.0461, -0.7360])

# Repeal
C_pi_r = np.array([-0.1758,  0.0794,  0.0085, -0.0910,  0.0514,  0.0000])
C_y_r  = np.array([ 0.1103, -1.4121, -0.2518, -1.4445,  1.0461,  0.0000])

rho   = np.array([0.684, 0.773, 0.739, 0.900, 0.869, 0.811])
sigma = np.array([0.0129, 0.0051, 0.1308, 0.0020, 0.0302, 0.0312])
names = ['Tech', 'US Infl', 'Oil', 'Fed Rate', 'Transfers', 'Shipping']

# ============================================================
# Finite-horizon FEVD
# ============================================================
def fevd(C, horizons=[1, 4, 8, 20]):
    out = {}
    for H in horizons:
        cum = np.zeros(6)
        for h in range(H):
            cum += (C * (rho**h) * sigma)**2
        out[H] = 100 * cum / cum.sum()
    return out

fevd_y_b  = fevd(C_y_b)
fevd_pi_b = fevd(C_pi_b)
fevd_y_r  = fevd(C_y_r)
fevd_pi_r = fevd(C_pi_r)

# ============================================================
# Asymptotic FEVD
# ============================================================
def asy(C):
    v = (C * sigma)**2 / (1 - rho**2)
    return 100 * v / v.sum()

asy_y_b  = asy(C_y_b)
asy_pi_b = asy(C_pi_b)
asy_y_r  = asy(C_y_r)
asy_pi_r = asy(C_pi_r)

# ============================================================
# TABLE 4 – Finite-horizon FEVD (Baseline)
# ============================================================
print("="*75)
print("TABLE 4 – Finite-horizon FEVD – BASELINE (%)")
print("="*75)

print("\nPanel A: Output Gap")
df_y = pd.DataFrame({
