# Solves the undetermined-coefficients system with output-gap feedback
# into the NKPC (ψ_y). Produces the baseline and repeal policy vectors
# used in the paper.

===========
# policy vectors

============

import numpy as np
from numpy.linalg import solve

# ============================================================
# Parameters
# ============================================================
beta      = 0.99
xi        = 0.75
kappa     = (1 - xi)*(1 - beta*xi)/xi          # ≈ 0.08583
sigma     = 2.0
lam       = 0.42
sigma_eff = sigma/(1 - lam)
omega_AD  = 0.58
Theta_ToT = 0.45
Gamma_tr  = 0.15
alpha     = 0.33
phi_pi    = 1.8

gamma_dir  = 0.142
theta_fuel = 0.50
psi_s      = 0.30

rho = np.array([0.684, 0.773, 0.739, 0.900, 0.869, 0.811])
names = ['a (tech)', 'pi*', 'oil', 'nu_i', 'tr', 'ship']

# Feedback from output gap into real marginal cost
# (this is the key term that was previously set to zero)
# Typical values in New Keynesian models: 0.1 – 0.5
psi_y = 0.08          # <-- you can tune this

# ============================================================
# Solve for given tau_JA and psi_s
# ============================================================
def solve_policy(tau_JA, psi_s, label=""):
    gamma = gamma_dir + tau_JA * theta_fuel

    def forcing(j):
        # Cost-push component of marginal cost
        if j == 0:   phi_mc = -(1 - alpha)          # technology
        elif j == 1: phi_mc = +alpha                # US inflation
        elif j == 2: phi_mc = +alpha * gamma        # oil
        elif j == 5: phi_mc = +alpha * psi_s        # shipping
        else:        phi_mc = 0.0

        D_pi = kappa * phi_mc

        # IS forcing
        rr = omega_AD / sigma_eff
        if j == 0:   D_y = 0.0
        elif j == 1: D_y = -rr * phi_pi
        elif j == 2: D_y = -Theta_ToT * gamma
        elif j == 3: D_y = -rr
        elif j == 4: D_y = +Gamma_tr
        elif j == 5: D_y = -Theta_ToT * psi_s
        else:        D_y = 0.0

        return D_pi, D_y

    C_pi = np.zeros(6)
    C_y  = np.zeros(6)

    for j in range(6):
        r = rho[j]
        D_pi, D_y = forcing(j)

        # System with output-gap feedback into the NKPC:
        # (1 - βρ) Cπ - κ·ψ_y · Cy  = D_pi
        # (ρ/σ_eff) Cπ + (1 - ρ) Cy = D_y
        A = np.array([
            [1 - beta*r,   -kappa * psi_y],
            [r / sigma_eff, 1 - r        ]
        ])
        b = np.array([D_pi, D_y])
        sol = solve(A, b)
        C_pi[j] = sol[0]
        C_y[j]  = sol[1]

    print("="*65)
    print(f"POLICY VECTORS – {label}")
    print(f"τ_JA = {tau_JA:.3f}   γ = {gamma:.4f}   ψ_s = {psi_s:.2f}   ψ_y = {psi_y}")
    print("="*65)
    print(f"{'Shock':<12} {'C_pi':>10} {'C_y':>10}")
    print("-"*35)
    for j, n in enumerate(names):
        print(f"{n:<12} {C_pi[j]:10.4f} {C_y[j]:10.4f}")
    print()
    print("C_pi =", np.round(C_pi, 4))
    print("C_y  =", np.round(C_y, 4))
    print()
    return C_pi, C_y

# ============================================================
# Baseline and Repeal
# ============================================================
C_pi_b, C_y_b = solve_policy(tau_JA=0.071, psi_s=0.30, label="BASELINE")
C_pi_r, C_y_r = solve_policy(tau_JA=0.000, psi_s=0.00, label="REPEAL")

