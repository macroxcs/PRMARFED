import numpy as np

# ============================================================
# Final baseline policy vectors (ψ_y = 0.08)
# ============================================================
C_pi = np.array([-0.1758,  0.0794,  0.0107, -0.0910,  0.0514,  0.0175])
C_y  = np.array([ 0.1103, -1.4121, -0.3148, -1.4445,  1.0461, -0.7360])

# Persistence and shock volatilities
rho   = np.array([0.684, 0.773, 0.739, 0.900, 0.869, 0.811])
sigma = np.array([0.0129, 0.0051, 0.1308, 0.0020, 0.0302, 0.0312])
names = ['Tech', 'US Infl', 'Oil', 'Fed Rate', 'Transfers', 'Shipping']

# ============================================================
# Asymptotic moments
# ============================================================
# Variances
var_y  = np.sum( (C_y  * sigma)**2 / (1 - rho**2) )
var_pi = np.sum( (C_pi * sigma)**2 / (1 - rho**2) )

std_y  = np.sqrt(var_y)
std_pi = np.sqrt(var_pi)

# First-order autocorrelations
auto_y  = np.sum( (C_y  * sigma)**2 * rho / (1 - rho**2) ) / var_y
auto_pi = np.sum( (C_pi * sigma)**2 * rho / (1 - rho**2) ) / var_pi

# Contemporaneous correlation
cov_ypi  = np.sum( C_y * C_pi * sigma**2 / (1 - rho**2) )
corr_ypi = cov_ypi / (std_y * std_pi)

# ============================================================
# Display
# ============================================================
print("=" * 65)
print("ASYMPTOTIC BUSINESS CYCLE MOMENTS (Final Vectors, ψ_y = 0.08)")
print("=" * 65)
print(f"{'Moment':<35} {'Model':>12}")
print("-" * 50)
print(f"{'σ(y)  – Output Gap':<35} {std_y:12.4f}")
print(f"{'σ(π)  – CPI Inflation':<35} {std_pi:12.4f}")
print(f"{'ρ(y_t, y_{t-1})':<35} {auto_y:12.4f}")
print(f"{'ρ(π_t, π_{t-1})':<35} {auto_pi:12.4f}")
print(f"{'Corr(y_t, π_t)':<35} {corr_ypi:12.4f}")
print("=" * 65)

print("\nContribution to asymptotic output variance (%):")
share_y = 100 * (C_y * sigma)**2 / (1 - rho**2) / var_y
for n, s in zip(names, share_y):
    print(f"  {n:<12}: {s:6.2f}%")

