# Sort Function & QZ Decomposition
def sort_stable(alpha, beta_qz):
    abs_beta = np.abs(beta_qz)
    abs_alpha = np.abs(alpha)
    gev = np.full(alpha.shape, np.inf)
    nonzero = abs_beta > 1e-12
    gev[nonzero] = abs_alpha[nonzero] / abs_beta[nonzero]
    return gev < 0.995

S, T, alpha, beta_qz, Q, Z = linalg.ordqz(G1, G0, sort=sort_stable, output="real")

# Partition Z matrix
Z11 = Z[:n_states, :n_states]
Z21 = Z[n_states:, :n_states]

# Compute Linear Decision Rules: Y_t = F * X_t
F = np.real(Z21 @ np.linalg.inv(Z11))
Cy_rec = F[0, :]
Cpi_rec = F[1, :]

df_verification = pd.DataFrame({
    "Shock": shocks,
    "Target Cy": Cy_target,
    "Recovered Cy": np.round(Cy_rec, 4),
    "Cy Error": np.round(Cy_rec - Cy_target, 6),
    "Target Cpi": Cpi_target,
    "Recovered Cpi": np.round(Cpi_rec, 4),
    "Cpi Error": np.round(Cpi_rec - Cpi_target, 6),
})

print("\n" + "=" * 85)
