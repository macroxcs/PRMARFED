G1 = np.zeros((n_dim, n_dim))

# Exogenous Block (Rows 0 to 5)
for i in range(n_states):
    G0[i, i] = 1.0
    G1[i, i] = rhos[i]

# Row 6: IS Aggregate Demand Curve for y_t (Index 6)
theta_y = 0.999999
G0[6, 6] = theta_y
G1[6, 6] = 1.0
for i in range(n_states):
    G1[6, i] = -Cy_target[i] * (rhos[i] - 1.0 / theta_y)

# Row 7: New Keynesian Phillips Curve for pi_t (Index 7)
