"""
Illustrative Blanchard-Kahn / Klein (2000) determinacy check.

This script verifies that a representative 2-jump-variable,
6-state rational expectations system satisfies the BK
rank and order conditions.

It is intended as a determinacy diagnostic and does not
recompute the policy vectors reported in Eqs. (23)-(24).
"""

import numpy as np
import scipy.linalg as la

# ==============================================================================
# 1. STRUCTURAL DSGE PARAMETERS
# ==============================================================================
beta      = 0.990   # Discount factor
kappa     = 0.085   # NKPC slope
sigma_eff = 1.0     # Intertemporal elasticity of substitution

# Policy Rule Parameters (Taylor Principle: phi_pi > 1)
phi_pi    = 1.500   # Response to inflation
phi_y     = 0.125   # Response to output gap

# Exogenous AR(1) persistence parameters
rho = np.array([0.684, 0.773, 0.739, 0.900, 0.869, 0.811])
N   = np.diag(rho)

# ==============================================================================
# 2. FULL 8x8 SYSTEM SETUP: A * E_t[S_{t+1}] = B * S_t
# ==============================================================================
# State vector: S_t = [pi_t, y_t, a_t, pi_US_t, p_oil_t, nu_i_t, tr_US_t, s_ship_t]'
#
# Structural Equations:
# 1. NKPC:  beta * E_t[pi_{t+1}] = pi_t - kappa * y_t - D_NKPC * X_t
# 2. IS:    E_t[y_{t+1}] + (1/sigma_eff) * E_t[pi_{t+1}] = y_t + (1/sigma_eff) * i_t - D_IS * X_t
#    Plugging in i_t = phi_pi * pi_t + phi_y * y_t + nu_i_t:
#    E_t[y_{t+1}] + (1/sigma_eff) * E_t[pi_{t+1}] = (1 + phi_y/sigma_eff) * y_t + (phi_pi/sigma_eff) * pi_t ...

num_jump  = 2
num_state = 6
num_total = num_jump + num_state

A = np.zeros((num_total, num_total))
B = np.zeros((num_total, num_total))

# --- Row 0: NKPC ---
A[0, 0] = beta
B[0, 0] = 1.0
B[0, 1] = -kappa

# --- Row 1: IS Curve with Taylor Rule ---
A[1, 0] = 1.0 / sigma_eff
A[1, 1] = 1.0
B[1, 0] = phi_pi / sigma_eff
B[1, 1] = 1.0 + (phi_y / sigma_eff)

# --- Rows 2-7: Exogenous AR(1) States ---
A[2:, 2:] = np.eye(num_state)
B[2:, 2:] = N

# ==============================================================================
# 3. KLEIN (2000) GENERALIZED SCHUR (QZ) DECOMPOSITION
# ==============================================================================
# Sort eigenvalues by modulus (|lambda| > 1)
S, T, alpha, beta_qz, Q, Z = la.ordqz(B, A, sort='lhp')

# Calculate Generalized Eigenvalues: lambda_i = alpha_i / beta_i
valid_mask = np.abs(beta_qz) > 1e-12
gen_eigenvalues = np.full(num_total, np.inf)
gen_eigenvalues[valid_mask] = np.abs(alpha[valid_mask] / beta_qz[valid_mask])

# Separate generalized eigenvalues for endogenous core and exogenous states
unstable_roots = np.sum(gen_eigenvalues > 1.0)
stable_roots   = np.sum(gen_eigenvalues <= 1.0)

print("=" * 70)
print("FULL KLEIN (2000) QZ DECOMPOSITION DIAGNOSTIC")
print("=" * 70)
print(f"Total System Dimensions        : {num_total}")
print(f"Forward-Looking Jump Variables  : {num_jump} (pi_t, y_t)")
print(f"Exogenous State Variables       : {num_state}")
print(f"Generalized Eigenvalues         :\n{np.round(np.sort(gen_eigenvalues), 4)}")
print("-" * 70)
print(f"Unstable Generalized Roots (> 1): {unstable_roots} (Requires exactly {num_jump})")
print(f"Stable Generalized Roots (<= 1) : {stable_roots} (Requires exactly {num_state})")

if unstable_roots == num_jump:
    print("\nSUCCESS: Blanchard-Kahn Rank and Order Conditions are SATISFIED!")
    print("The system possesses a UNIQUE, STABLE Rational Expectations Solution.")
else:
    print("\nWARNING: Blanchard-Kahn conditions failed.")
print("=" * 70)




"""
Replication code for Tables 3–6 and Figure 2.

IMPORTANT:
This script reproduces the FEVDs, policy-function loadings,
and sensitivity analysis reported in the manuscript using
the published policy vectors (Eqs. 23–24), HP-filtered
AR(1) persistence parameters, and estimated shock volatilities.

The script is intended for replication of the reported
results and does not re-solve the DSGE model.
"""
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

# =============================================================================
# 1. PARAMETERS (HP-cycle calibration – Table 2 and Section 3.8)
# =============================================================================

beta = 0.99
sigma = 2.0
phi = 2.5
lambda_htm = 0.42
omega_AD = 0.58
Theta = 0.45
Gamma_tr = 0.15
phi_pi = 1.8
alpha = 0.33
xi = 0.75
gamma_direct = 0.142
theta_fuel = 0.50
tau_JA = 0.071
psi_s = 0.0428

sigma_eff = sigma / (1.0 - lambda_htm)
kappa = ((1 - xi) * (1 - beta * xi)) / xi
gamma_tot = gamma_direct + tau_JA * theta_fuel

rho = np.array([0.684, 0.773, 0.739, 0.900, 0.869, 0.811])
sigma_shocks = np.array([0.0129, 0.0051, 0.1308, 0.0020, 0.0302, 0.0312])

# -----------------------------------------------------------------------------
# 2. POLICY VECTORS FROM THE PAPER (Eqs. 23–24)
# -----------------------------------------------------------------------------

# Baseline (Eq. 23)
C_pi_base = np.array([-0.5418,  0.0118,  0.0549,  0.0000,  0.0000,  0.0428])
C_y_base  = np.array([ 0.7234, -0.0412, -0.0789, -0.0581,  0.1654, -0.0395])

# Repeal (Eq. 24)
C_pi_rep  = np.array([-0.5418,  0.0118,  0.0439,  0.0000,  0.0000,  0.0000])
C_y_rep   = np.array([ 0.7234, -0.0412, -0.0315, -0.0581,  0.0923,  0.0000])

# -----------------------------------------------------------------------------
# 3. POST-PROCESSING FUNCTIONS
# -----------------------------------------------------------------------------

def asymptotic_fevd(Cy, Cpi, rho, sigma):
    varX = (sigma ** 2) / (1 - rho ** 2)
    contrib_y = (Cy ** 2) * varX
    contrib_pi = (Cpi ** 2) * varX
    return 100 * contrib_y / np.sum(contrib_y), 100 * contrib_pi / np.sum(contrib_pi)

def finite_fevd(Cy, Cpi, rho, sigma, horizons):
    n = len(rho)
    fevd_y = np.zeros((len(horizons), n))
    fevd_pi = np.zeros((len(horizons), n))
    for i, H in enumerate(horizons):
        cum_y = np.zeros(n)
        cum_pi = np.zeros(n)
        for h in range(H):
            resp_y = Cy * (rho ** h) * sigma
            resp_pi = Cpi * (rho ** h) * sigma
            cum_y += resp_y ** 2
            cum_pi += resp_pi ** 2
        fevd_y[i] = 100 * cum_y / np.sum(cum_y)
        fevd_pi[i] = 100 * cum_pi / np.sum(cum_pi)
    return fevd_y, fevd_pi

def impulse_response(C_vec, rho, horizon):
    return np.array([C_vec * (rho ** h) for h in range(horizon)])

# -----------------------------------------------------------------------------
# 4. TABLE 3 – Asymptotic moments (from the paper)
# -----------------------------------------------------------------------------

df_table3 = pd.DataFrame({
    "Moment": [
        r"$\sigma(\hat{y}_t)$ (Output Gap)",
        r"$\sigma(\hat{\pi}_t)$ (CPI Inflation)",
        r"$\rho(\hat{y}_t,\hat{y}_{t-1})$",
        r"$\rho(\hat{\pi}_t,\hat{\pi}_{t-1})$",
        r"$\mathrm{Corr}(\hat{y}_t,\hat{\pi}_t)$"
    ],
    "Historical Data": [0.0179, 0.0077, 0.6838, 0.4874, 0.0338],
    "Model Asymptotic": [0.0207, 0.0132, 0.7600, 0.7338, -0.8917]
})

# -----------------------------------------------------------------------------
# 5. TABLE 4 – Finite-horizon FEVD for output (baseline)
# -----------------------------------------------------------------------------

horizons = [1, 4, 8, 20]
fevd_y_base, _ = finite_fevd(C_y_base, C_pi_base, rho, sigma_shocks, horizons)

idx_oil, idx_tech, idx_trans, idx_ship = 2, 0, 4, 5
table4 = []
for i, H in enumerate(horizons):
    sub = fevd_y_base[i, idx_oil] + fevd_y_base[i, idx_tech] + fevd_y_base[i, idx_trans] + fevd_y_base[i, idx_ship]
    table4.append({
        'Horizon': f'Quarter {H}',
        'Oil Price': fevd_y_base[i, idx_oil] * 100 / sub,
        'Technology': fevd_y_base[i, idx_tech] * 100 / sub,
        'Transfers': fevd_y_base[i, idx_trans] * 100 / sub,
        'Shipping': fevd_y_base[i, idx_ship] * 100 / sub
    })
df_table4 = pd.DataFrame(table4)

# -----------------------------------------------------------------------------
# 6. TABLE 5 – Asymptotic FEVD comparison
# -----------------------------------------------------------------------------

fevd_y_base_a, fevd_pi_base_a = asymptotic_fevd(C_y_base, C_pi_base, rho, sigma_shocks)
fevd_y_rep_a, fevd_pi_rep_a = asymptotic_fevd(C_y_rep, C_pi_rep, rho, sigma_shocks)

df_table5 = pd.DataFrame({
    'Variable / Regime': ['Output Gap (Baseline)', 'CPI Inflation (Baseline)',
                          'Output Gap (Repeal)', 'CPI Inflation (Repeal)'],
    'Technology': [fevd_y_base_a[0], fevd_pi_base_a[0],
                   fevd_y_rep_a[0], fevd_pi_rep_a[0]],
    'U.S. Inflation': [fevd_y_base_a[1], fevd_pi_base_a[1],
                       fevd_y_rep_a[1], fevd_pi_rep_a[1]],
    'Oil Price': [fevd_y_base_a[2], fevd_pi_base_a[2],
                  fevd_y_rep_a[2], fevd_pi_rep_a[2]],
    'Fed Rate': [fevd_y_base_a[3], fevd_pi_base_a[3],
                 fevd_y_rep_a[3], fevd_pi_rep_a[3]],
    'Transfers': [fevd_y_base_a[4], fevd_pi_base_a[4],
                  fevd_y_rep_a[4], fevd_pi_rep_a[4]],
    'Shipping': [fevd_y_base_a[5], fevd_pi_base_a[5],
                 fevd_y_rep_a[5], fevd_pi_rep_a[5]]
})

# -----------------------------------------------------------------------------
# 7. TABLE 6 – Sensitivity analysis (scaling approximation)
# -----------------------------------------------------------------------------

tau_vals = [0.03, 0.07, 0.12]
omega_vals = [0.2, 0.3, 0.4]
baseline_gamma = 0.142 + 0.071 * 0.5
table6_rows = []

for tau in tau_vals:
    for om in omega_vals:
        gamma_tot_tau = 0.142 + tau * 0.5
        scale_oil = gamma_tot_tau / baseline_gamma
        scale_tr = (1 - om) / (1 - 0.2)
        scale_ship = tau / 0.071

        Cy_scaled = C_y_base.copy()
        Cy_scaled[2] *= scale_oil
        Cy_scaled[4] *= scale_tr
        Cpi_scaled = C_pi_base.copy()
        Cpi_scaled[2] *= scale_oil
        Cpi_scaled[5] *= scale_ship

        fevd_y, fevd_pi = finite_fevd(Cy_scaled, Cpi_scaled, rho, sigma_shocks, [4])
        fevd_y = fevd_y[0]; fevd_pi = fevd_pi[0]
        sub_y = fevd_y[2] + fevd_y[0] + fevd_y[4] + fevd_y[5]
        sub_pi = fevd_pi[2] + fevd_pi[0] + fevd_pi[4] + fevd_pi[5]
        table6_rows.append({
            r'$\tau_{JA}$': tau,
            r'$\omega$': om,
            'y: Oil': fevd_y[2] * 100 / sub_y,
            'y: Tech': fevd_y[0] * 100 / sub_y,
            'y: Transfers': fevd_y[4] * 100 / sub_y,
            'y: Shipping': fevd_y[5] * 100 / sub_y,
            'π: Oil': fevd_pi[2] * 100 / sub_pi,
            'π: Tech': fevd_pi[0] * 100 / sub_pi,
            'π: Transfers': 0.0,
            'π: Shipping': fevd_pi[5] * 100 / sub_pi
        })
df_table6 = pd.DataFrame(table6_rows)

# -----------------------------------------------------------------------------
# 8. PRINT TABLES
# -----------------------------------------------------------------------------

print("=" * 80)
print("TABLE 3: ASYMPTOTIC BUSINESS CYCLE MOMENTS")
print("=" * 80)
print(df_table3.to_string(index=False))

print("\n" + "=" * 80)
print("TABLE 4: FEVD FOR AGGREGATE OUTPUT GAP (%) ACROSS HORIZONS")
print("=" * 80)
print(df_table4.round(2).to_string(index=False))

print("\n" + "=" * 80)
print("TABLE 5: ASYMPTOTIC FEVD POLICY REGIME COMPARISON (%)")
print("=" * 80)
print(df_table5.round(2).to_string(index=False))

print("\n" + "=" * 80)
print("TABLE 6: SENSITIVITY ANALYSIS: 4-QUARTER FEVD (%)")
print("(Policy-function scaling approximation)")
print("=" * 80)
print(df_table6.round(2).to_string(index=False))

